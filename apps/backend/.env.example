# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/mediconnect"

# JWT
JWT_SECRET="votre_secret_jwt_tres_long_et_securise"
JWT_EXPIRES_IN="24h"

# Redis (pour BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3001"

# GoMobile
GOMOBILE_API_URL="http://105.190.82.156:3000/api"
GOMOBILE_API_KEY="your_api_key_here"

GOMOBILE_SENDER_ID="GOMOBILE"
GOMOBILE_FLOW_ID_H24="your-flow-uuid"
GOMOBILE_DID_ID="your-did-uuid"

# Email
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
MAIL_FROM="MediConnect <noreply@example.com>"

# BullMQ
BULL_QUEUE_NAME="mediconnect-queue"
